#!/usr/bin/env bash
#
# gh-reaper - GitHub CLI extension that harvests stale git worktrees
# Version: 1.9.0
# https://github.com/ai-ecoverse/gh-reaper
#
# Seasons don't fear the reaper. Nor do your forgotten worktrees -- until now.
# Scans a curated set of developer directories for linked git worktrees,
# reports how long they've been gathering dust and how much disk they hold,
# then offers to reap the ones you've left behind.

set -euo pipefail

VERSION="1.9.0"
EXTENSION_NAME="gh-reaper"

# Space-delimited, space-padded list of the roots this run scans. Consulted when
# reaping, to know which directories are containers we own and which are yours.
SCAN_ROOTS=" "

# Absolute path to this script, so we can re-invoke ourselves as parallel
# inspection workers (see the --__inspect dispatch at the bottom).
SELF_PATH="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"

# Default parallelism = online CPU count (capped), overridable with --jobs.
detect_jobs() {
    local n
    n="$(getconf _NPROCESSORS_ONLN 2>/dev/null \
         || sysctl -n hw.ncpu 2>/dev/null \
         || nproc 2>/dev/null || echo 4)"
    case "$n" in *[!0-9]*|'') n=4 ;; esac
    [ "$n" -gt 16 ] && n=16
    [ "$n" -lt 1 ] && n=1
    echo "$n"
}

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
check_dependencies() {
    local missing=()
    command -v git  >/dev/null 2>&1 || missing+=("git")
    command -v find >/dev/null 2>&1 || missing+=("find")
    command -v du   >/dev/null 2>&1 || missing+=("du")
    command -v stat >/dev/null 2>&1 || missing+=("stat")
    if [ ${#missing[@]} -ne 0 ]; then
        echo "Error: missing required dependencies:" >&2
        printf '  - %s\n' "${missing[@]}" >&2
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Colors (TTY + NO_COLOR aware)
# ---------------------------------------------------------------------------
setup_colors() {
    if [ "${opt_color}" = 1 ] && [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
        C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'; C_GREEN=$'\033[32m'
        C_CYAN=$'\033[36m'
    else
        C_RESET=''; C_BOLD=''; C_DIM=''
        C_RED=''; C_YELLOW=''; C_GREEN=''; C_CYAN=''
    fi
}

# ---------------------------------------------------------------------------
# Help / version
# ---------------------------------------------------------------------------
show_version() {
    echo "${EXTENSION_NAME} version ${VERSION}"
}

show_help() {
    cat <<EOF
${C_BOLD}gh reaper${C_RESET} - harvest stale git worktrees

  ${C_DIM}"All our times have come / Here but now they're gone"${C_RESET}

USAGE:
  gh reaper [OPTIONS] [PATH...]

DESCRIPTION:
  Scans your developer directories for linked git worktrees and shows when each
  was last touched and how much disk it occupies (oldest first). By default it
  is READ-ONLY -- it lists and changes nothing. Add --reap to actually delete.
  It only walks well-known code roots so it stays fast and never trips macOS
  privacy (TCC) prompts for Desktop, Documents, Downloads, Photos, and friends.

  AGE reflects the newest *non-gitignored* change (tracked/unignored file mtime
  or last commit) -- so a routine 'npm install' or build no longer resets a
  worktree's apparent age. Each worktree is also checked for whether its work is
  already MERGED into the repo's default branch -- a far stronger "done" signal
  than age alone.

  A worktree someone is working in right now is BUSY -- a running process (an
  agent, a dev server, a test watcher) has its current directory inside the
  tree. Busy worktrees are never swept without --force, however merged they
  look. Idle interactive shells don't count.

  A worktree bb (getbb.app) manages whose thread is still open is BB-LIVE: bb
  asks it for the thread's next turn, merged branch or not. gh reaper asks the
  'bb' CLI once per run; bb-live worktrees are never reaped, not even with
  --force. Archive the thread in bb to release its worktree. If bb can't be
  asked, every bb-managed worktree counts as bb-live.

OPTIONS:
  -r, --reap           Delete worktrees (interactive unless --yes). Without this,
                       gh reaper only lists -- it never removes anything.
  -d, --min-age DAYS   Only show worktrees untouched for at least DAYS (default: 0)
  -s, --min-size MB    Only show worktrees at least MB megabytes in size (default: 0)
  -m, --merged         Only show worktrees whose HEAD is merged into the default
                       branch (with --reap, sweep exactly the done ones)
      --check-prs      For non-merged branches, ask 'gh' whether their PR was
                       merged (catches squash-merges; needs gh auth + network)
      --no-ignore-locks  Count dependency lock-file changes (package-lock.json,
                       yarn.lock, Cargo.lock, ...) as dirty. By default a worktree
                       whose only change is regenerable lock churn is not dirty.
  -p, --path DIR       Add a scan root (repeatable; also accepted as PATH args)
  -j, --jobs N         Parallel inspection workers (default: CPU count; 1 = serial)
  -a, --all            Scan all of \$HOME (still skips TCC-protected dirs)
  -y, --yes            With --reap, delete without prompting for each worktree
  -f, --force          With --reap, also remove dirty, unpushed, busy, or
                       orphaned worktrees (never bb-live ones)
      --prune          With --reap, run 'git worktree prune' on touched repos afterward
      --json           Emit results as JSON (always read-only)
      --dry-run        List only, change nothing (this is the default; kept for habit)
      --no-color       Disable colored output
  -v, --version        Show version
  -h, --help           Show this help

STATUS FLAGS:
  ${C_GREEN}merged${C_RESET}     HEAD is already in the default branch -- done, safe to reap
  ${C_GREEN}pr-merged${C_RESET}  Branch's pull request was merged (squash-merge; --check-prs)
  ${C_GREEN}clean${C_RESET}      No local changes; HEAD exists on a remote -- safe to reap
  ${C_YELLOW}dirty${C_RESET}      Uncommitted or untracked changes present
  ${C_YELLOW}unpushed${C_RESET}   Commits that exist nowhere on a remote
  ${C_CYAN}busy${C_RESET}       A live process is working in this tree -- leave it alone
  ${C_CYAN}bb-live${C_RESET}    Worktree of an open bb thread -- never reaped, even with --force
  ${C_DIM}locked${C_RESET}     'git worktree lock' is set; reaping lifts a lock whose
             owning process is gone (a live owner reads as busy instead)
  ${C_RED}orphan${C_RESET}     Main repository is gone; only the checkout remains

EXAMPLES:
  # Survey forgotten worktrees -- read-only, the default
  gh reaper

  # Anything untouched for 30+ days and bigger than 100 MB
  gh reaper --min-age 30 --min-size 100

  # Scan a specific spot, then reap interactively
  gh reaper ~/work/monorepo --reap

  # Reap everything 2+ weeks old, no prompts
  gh reaper --min-age 14 --reap --yes

  # Sweep only worktrees whose work is already merged (incl. squashed PRs)
  gh reaper --merged --check-prs --reap

  # Machine-wide survey (still skips TCC-protected dirs)
  gh reaper --all

More cowbell: https://github.com/ai-ecoverse/gh-reaper
EOF
}

# ---------------------------------------------------------------------------
# Defaults / option state
# ---------------------------------------------------------------------------
opt_min_age_days=0
opt_min_size_mb=0
opt_jobs=""
opt_all=0
opt_reap=0
opt_dry_run=0
opt_yes=0
opt_force=0
opt_prune=0
opt_json=0
opt_color=1
opt_merged_only=0
opt_check_prs=0
opt_ignore_locks=1
extra_roots=()

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -r|--reap) opt_reap=1; shift ;;
            -d|--min-age) opt_min_age_days="${2:?--min-age needs a value}"; shift 2 ;;
            -s|--min-size) opt_min_size_mb="${2:?--min-size needs a value}"; shift 2 ;;
            -j|--jobs) opt_jobs="${2:?--jobs needs a value}"; shift 2 ;;
            -p|--path) extra_roots+=("${2:?--path needs a value}"); shift 2 ;;
            -a|--all) opt_all=1; shift ;;
            --dry-run) opt_dry_run=1; shift ;;
            -y|--yes) opt_yes=1; shift ;;
            -f|--force) opt_force=1; shift ;;
            --prune) opt_prune=1; shift ;;
            -m|--merged) opt_merged_only=1; shift ;;
            --check-prs|--prs) opt_check_prs=1; shift ;;
            --no-ignore-locks) opt_ignore_locks=0; shift ;;
            --json) opt_json=1; shift ;;
            --no-color) opt_color=0; shift ;;
            -v|--version) opt_color=0; setup_colors; show_version; exit 0 ;;
            -h|--help) setup_colors; show_help; exit 0 ;;
            --) shift; while [ $# -gt 0 ]; do extra_roots+=("$1"); shift; done ;;
            -*) echo "Error: unknown option '$1' (try --help)" >&2; exit 1 ;;
            *) extra_roots+=("$1"); shift ;;
        esac
    done

    case "$opt_min_age_days" in *[!0-9]*) echo "Error: --min-age must be a whole number" >&2; exit 1 ;; esac
    case "$opt_min_size_mb"  in *[!0-9]*) echo "Error: --min-size must be a whole number" >&2; exit 1 ;; esac
    if [ -n "$opt_jobs" ]; then
        case "$opt_jobs" in *[!0-9]*) echo "Error: --jobs must be a whole number" >&2; exit 1 ;; esac
        [ "$opt_jobs" -lt 1 ] && { echo "Error: --jobs must be 1 or more" >&2; exit 1; }
    fi

    # Read-only modes win over --reap, so habit and scripts can't delete by surprise.
    if [ "$opt_dry_run" = 1 ] || [ "$opt_json" = 1 ]; then opt_reap=0; fi
}

# ---------------------------------------------------------------------------
# Portable mtime (epoch seconds)
# ---------------------------------------------------------------------------
file_mtime() {
    local f="$1"
    if [ "$STAT_GNU" = 1 ]; then
        stat -c %Y "$f" 2>/dev/null || echo 0
    else
        stat -f %m "$f" 2>/dev/null || echo 0
    fi
}

# Newest mtime (epoch seconds) among a worktree's tracked + untracked-but-not-
# -ignored files. This deliberately excludes gitignored paths (node_modules,
# dist, build output, caches) so that a routine install/build/checkout does not
# reset a worktree's apparent age. Prints 0 when there are no such files.
newest_unignored_mtime() {
    local wt="$1" newest
    # Agent session markers are always excluded; regenerable lock files too,
    # unless --no-ignore-locks -- so a lone `npm install` or an agent's session
    # pointer doesn't make a stale worktree look freshly touched.
    local excl=( "${ARTIFACT_EXCLUDE[@]}" )
    [ "${REAPER_IGNORE_LOCKS:-1}" = 1 ] && excl+=( "${LOCK_EXCLUDE[@]}" )
    newest="$( { git -C "$wt" ls-files -z -- . "${excl[@]}" 2>/dev/null
                 git -C "$wt" ls-files -z --others --exclude-standard -- . "${excl[@]}" 2>/dev/null; } \
        | ( cd "$wt" 2>/dev/null || exit 0
            if [ "$STAT_GNU" = 1 ]; then xargs -0 stat -c %Y 2>/dev/null
            else                          xargs -0 stat -f %m 2>/dev/null; fi ) \
        | sort -rn | head -1 )"
    case "$newest" in ''|*[!0-9]*) echo 0 ;; *) echo "$newest" ;; esac
}

# ---------------------------------------------------------------------------
# Human-readable helpers
# ---------------------------------------------------------------------------
human_size_kb() {
    local kb="$1"
    if   [ "$kb" -ge 1048576 ]; then awk -v k="$kb" 'BEGIN{printf "%.1fG", k/1048576}'
    elif [ "$kb" -ge 1024 ];    then awk -v k="$kb" 'BEGIN{printf "%.1fM", k/1024}'
    else printf '%dK' "$kb"; fi
}

human_age() {
    local secs="$1" d
    [ "$secs" -lt 0 ] && secs=0
    d=$(( secs / 86400 ))
    if   [ "$d" -ge 365 ]; then printf '%dy'  $(( d / 365 ))
    elif [ "$d" -ge 30 ];  then printf '%dmo' $(( d / 30 ))
    elif [ "$d" -ge 1 ];   then printf '%dd'  "$d"
    else printf '%dh' $(( secs / 3600 )); fi
}

# Replace $HOME prefix with ~ for display
tilde() {
    local p="$1"
    case "$p" in
        "$HOME"/*) printf '~%s' "${p#"$HOME"}" ;;
        "$HOME")   printf '~' ;;
        *)         printf '%s' "$p" ;;
    esac
}

# ---------------------------------------------------------------------------
# Live processes
# ---------------------------------------------------------------------------
# Is a pid still running? `kill -0` answers for our own processes; it reports
# EPERM (not "gone") for another user's, so fall back to `ps` before calling a
# pid dead -- a wrong "dead" here would unlock a worktree someone still holds.
pid_alive() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$1" 2>/dev/null && return 0
    ps -p "$1" >/dev/null 2>&1
}

# Interactive shells parked in a worktree are not work in progress -- a leftover
# terminal tab would otherwise brand half the fields busy forever. Everything
# else with a cwd inside a tree (agent, dev server, test watcher, build) counts.
SHELL_COMMANDS=" sh bash zsh fish tcsh csh ksh dash ash elvish nu nushell pwsh login screen tmux "

# Emit "<pid>\t<command>\t<cwd>" for every running process: /proc on Linux, lsof
# elsewhere. Silence is a valid answer (no /proc, no lsof, no permission) --
# busy is an extra guard on top of the git signals, never a prerequisite.
process_cwds() {
    local cwd comm d line pid="" cmd=""
    # REAPER_PROC_DIR points the Linux branch at a fixture so it can be
    # exercised on hosts without a /proc (the test suite does this); it is an
    # internal seam, not a public interface.
    local procdir="${REAPER_PROC_DIR:-/proc}"
    if [ -r "$procdir/self/cwd" ]; then
        for d in "$procdir"/[0-9]*; do
            cwd="$(readlink "$d/cwd" 2>/dev/null)" || continue
            [ -n "$cwd" ] || continue
            comm=""
            IFS= read -r comm < "$d/comm" 2>/dev/null || comm=""
            printf '%s\t%s\t%s\n' "${d##*/}" "$comm" "$cwd"
        done
        return 0
    fi
    command -v lsof >/dev/null 2>&1 || return 0
    # -F pcn gives 'p<pid>' then 'c<command>' per process, then 'n<path>' for its
    # cwd; +c 0 stops lsof truncating the command to 9 characters, which would
    # let a long-named binary masquerade as a shell.
    while IFS= read -r line; do
        case "$line" in
            p*) pid="${line#p}" ;;
            c*) cmd="${line#c}" ;;
            n*) [ -n "${line#n}" ] && printf '%s\t%s\t%s\n' "$pid" "$cmd" "${line#n}" ;;
        esac
    done < <(lsof -w -n -P +c 0 -d cwd -F pcn 2>/dev/null || true)
}

# Our own chain (gh -> bash running this script) has its cwd wherever the user
# invoked us -- often inside a worktree being surveyed. Counting ourselves would
# brand that tree busy and refuse to ever reap it, so walk up and skip our pids.
self_pid_chain() {
    local p="$$" chain=" " hops=0
    while [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null && [ "$hops" -lt 32 ]; do
        chain="$chain$p "
        hops=$(( hops + 1 ))
        p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -cd '[:digit:]')"
    done
    printf '%s' "$chain"
}

# Of the worktree paths given, print those holding a live non-shell process.
busy_worktrees() {
    local wts=("$@") phys=() pid cmd cwd wt i p seen=" " self
    [ ${#wts[@]} -gt 0 ] || return 0
    # Compare on resolved paths as well as the ones we display: `pwd` keeps
    # symlinks (/var/folders/...) while the process table reports the target
    # (/private/var/folders/...), so a worktree reached through a symlinked
    # root -- /tmp and /var on macOS, plenty of home directories -- would
    # otherwise never look busy.
    for wt in "${wts[@]}"; do
        p="$(cd "$wt" 2>/dev/null && pwd -P)" || p=""
        phys+=("${p:-$wt}")
    done
    self="$(self_pid_chain)"
    while IFS=$'\t' read -r pid cmd cwd; do
        [ -n "$cwd" ] || continue
        case "$self" in *" $pid "*) continue ;; esac
        case "$SHELL_COMMANDS" in *" $cmd "*) continue ;; esac
        for i in "${!wts[@]}"; do
            wt="${wts[$i]}"
            case "$seen" in *" $wt "*) continue ;; esac
            case "$cwd" in
                "$wt"|"$wt"/*|"${phys[$i]}"|"${phys[$i]}"/*)
                    seen="$seen$wt "; printf '%s\n' "$wt" ;;
            esac
        done
    done < <(process_cwds)
}

# Fold the busy signal into the collected RECORDS. One process-table scan serves
# every worktree, so this runs once per invocation rather than per worker.
annotate_busy() {
    [ "${#RECORDS[@]}" -gt 0 ] || return 0
    local rec touched kb branch status path main paths=() busyset=" " b out=()
    for rec in "${RECORDS[@]}"; do
        IFS=$'\t' read -r touched kb branch status path main <<<"$rec"
        paths+=("$path")
    done
    while IFS= read -r b; do
        [ -n "$b" ] && busyset="$busyset$b "
    done < <(busy_worktrees "${paths[@]}")
    [ "$busyset" = " " ] && return 0
    for rec in "${RECORDS[@]}"; do
        IFS=$'\t' read -r touched kb branch status path main <<<"$rec"
        case "$busyset" in
            *" $path "*)
                case "$status" in
                    *busy*) ;;                       # already flagged via its lock owner
                    clean)  status="busy" ;;
                    *)      status="busy $status" ;;
                esac
                ;;
        esac
        out+=("$touched"$'\t'"$kb"$'\t'"$branch"$'\t'"$status"$'\t'"$path"$'\t'"$main")
    done
    RECORDS=("${out[@]}")
}

# ---------------------------------------------------------------------------
# bb (getbb.app) thread lifecycle
# ---------------------------------------------------------------------------
# bb gives every thread its own worktree environment and keeps it for as long as
# the thread is open -- not for as long as its branch is unmerged. A thread whose
# PR has merged still reads `merged clean`, yet its next turn runs in that tree;
# reap it and bb can't restore it (one `--merged --reap` swept nine live
# threads this way). So a bb-managed worktree is checked against bb itself: one
# whose thread is still open reads `bb-live` and is never reaped, not even with
# --force. Only a worktree whose thread bb confirms archived or deleted goes on to
# the usual rules. If bb can't be asked, every bb worktree is `bb-live`.

# Where current bb keeps worktree environments, relative to its data dir.
BB_WT_SUBDIR="plugins/environment-git-worktree/host-data/worktrees"

# Candidate bb data dirs: $BB_DATA_DIR, the default, and a dev build's.
bb_data_dirs() {
    [ -n "${BB_DATA_DIR:-}" ] && printf '%s\n' "${BB_DATA_DIR%/}"
    printf '%s\n' "$HOME/.bb" "$HOME/.bb-dev"
}

# The path, plus its symlink-resolved form when that differs.
path_forms() {
    local p="$1" r
    printf '%s\n' "$p"
    r="$(cd "$p" 2>/dev/null && pwd -P)" || r=""
    [ -n "$r" ] && [ "$r" != "$p" ] && printf '%s\n' "$r"
    return 0
}

# If PATH is a bb-managed worktree, print its env dir name (the directory right
# below bb's worktrees dir: thr_<id>-<n> today, env_<id> on older bb) and
# succeed. The current layout is recognized under any data dir, so a relocated
# one is still protected; the old, generic-looking <data-dir>/worktrees/ only
# under a known data dir.
bb_env_dir_of() {
    local p dd rest=""
    while IFS= read -r p; do
        case "$p" in
            */"$BB_WT_SUBDIR"/?*) rest="${p##*/"$BB_WT_SUBDIR"/}" ;;
            *)
                while IFS= read -r dd; do
                    case "$p" in "$dd"/worktrees/?*) rest="${p#"$dd"/worktrees/}"; break ;; esac
                done < <(bb_data_dirs)
                ;;
        esac
        [ -n "$rest" ] && break
    done < <(path_forms "$1")
    [ -n "$rest" ] || return 1
    printf '%s\n' "${rest%%/*}"
}

# The bb CLI to ask: `bb` on PATH, else the daemon-managed $BB_CLI.
bb_cli() {
    local b
    b="$(command -v bb 2>/dev/null)" || b=""
    [ -z "$b" ] && [ -n "${BB_CLI:-}" ] && [ -x "$BB_CLI" ] && b="$BB_CLI"
    [ -n "$b" ] || return 1
    printf '%s\n' "$b"
}

# Space-padded key sets filled by bb_load_threads: ids of open threads, of their
# environments, and the env dir names they run in (BB_LIVE); the same for
# archived / deleted threads (BB_GONE).
BB_LIVE=" "; BB_GONE=" "; BB_CLI_DATA_DIR=""; BB_FAIL=""; BB_BIN=""

# Ask bb for every thread it knows -- open and archived, hidden included -- in
# two list calls. On any failure set BB_FAIL to the reason and return 1.
bb_load_threads() {
    BB_BIN="$(bb_cli)" || { BB_FAIL="the bb CLI is not installed"; return 1; }
    command -v jq >/dev/null 2>&1 || { BB_FAIL="jq is not installed"; return 1; }
    local open arch keys state key
    open="$("$BB_BIN" thread list --json --include-hidden 2>/dev/null)" \
        || open="$("$BB_BIN" thread list --json 2>/dev/null)" \
        || { BB_FAIL="'bb thread list' failed"; return 1; }
    arch="$("$BB_BIN" thread list --json --archived --include-hidden 2>/dev/null)" \
        || arch="$("$BB_BIN" thread list --json --archived 2>/dev/null)" \
        || { BB_FAIL="'bb thread list --archived' failed"; return 1; }
    # Both must be bare arrays; a failure envelope is an object. Fed on stdin:
    # a busy bb's thread list is megabytes, past ARG_MAX as an argument.
    keys="$(printf '%s\n%s\n' "$open" "$arch" | jq -rs --arg sub "$BB_WT_SUBDIR" '
        if length != 2 or (.[0]|type) != "array" or (.[1]|type) != "array"
        then error("shape") else . end |
        (.[0] + .[1])[] |
        (if .archivedAt == null and .deletedAt == null then "live" else "gone" end) as $s |
        ((.environmentPath // "") as $p |
            if ($p|index("/" + $sub + "/")) then ($p | split("/" + $sub + "/")[1] | split("/")[0])
            elif ($p|test("/worktrees/env_")) then ($p | split("/worktrees/")[-1] | split("/")[0])
            else "" end) as $d |
        [.id, .environmentId, $d][] | select(. != null and . != "") | "\($s) \(.)"
    ' 2>/dev/null)" || { BB_FAIL="bb returned unexpected output"; return 1; }
    while read -r state key; do
        [ -n "$key" ] || continue
        if [ "$state" = live ]; then BB_LIVE="$BB_LIVE$key "; else BB_GONE="$BB_GONE$key "; fi
    done <<<"$keys"
    # The data dir this bb serves. "No such thread" is only proof of deletion
    # for worktrees under it -- a dev build's threads are unknown to the release
    # CLI, not deleted.
    BB_CLI_DATA_DIR="$("$BB_BIN" status --json 2>/dev/null | jq -r '.dataDir // empty' 2>/dev/null)" \
        || BB_CLI_DATA_DIR=""
    [ -n "$BB_CLI_DATA_DIR" ] || BB_CLI_DATA_DIR="${BB_DATA_DIR:-$HOME/.bb}"
    BB_CLI_DATA_DIR="${BB_CLI_DATA_DIR%/}"
    return 0
}

# Is PATH under the data dir the bb CLI serves?
bb_served_by_cli() {
    local p d
    while IFS= read -r p; do
        while IFS= read -r d; do
            case "$p" in "$d"/*) return 0 ;; esac
        done < <(path_forms "$BB_CLI_DATA_DIR")
    done < <(path_forms "$1")
    return 1
}

# Decide one bb worktree: succeed (bb-live) unless bb confirms its thread is
# archived or deleted. Anything unrecognized or unanswerable is live.
bb_is_live() {
    local env="$1" path="$2" id out
    # Some open thread runs in this env dir (threads can share an environment,
    # so this outranks whatever thread the dir happens to be named after).
    case "$BB_LIVE" in *" $env "*) return 0 ;; esac
    case "$env" in
        thr_*)
            id="${env%-[0-9]*}"
            case "$id" in thr_*[!a-z0-9_]*|thr_) return 0 ;; esac
            case "$BB_LIVE" in *" $id "*) return 0 ;; esac
            case "$BB_GONE" in *" $id "*) return 1 ;; esac
            # Not in either list: ask for it by name.
            if out="$("$BB_BIN" thread show "$id" --json 2>/dev/null)"; then
                [ "$(printf '%s' "$out" | jq -r '
                    if (.thread|type) == "object" and (.thread.archivedAt != null
                       or .thread.deletedAt != null) then "gone" else "live" end' 2>/dev/null)" = gone ] \
                    && return 1
                return 0
            fi
            [ "$(printf '%s' "$out" | jq -r '.error.code // empty' 2>/dev/null)" = thread_not_found ] \
                && bb_served_by_cli "$path" && return 1
            return 0
            ;;
        env_*)
            # Older bb names the dir after the environment.
            case "$BB_LIVE" in *" $env "*) return 0 ;; esac
            case "$BB_GONE" in *" $env "*) return 1 ;; esac
            # No thread at all references it: its threads were deleted.
            bb_served_by_cli "$path" && return 1
            return 0
            ;;
    esac
    return 0
}

# Fold the bb-live verdict into RECORDS. bb is only consulted when some
# worktree is bb-managed, and at most once per run.
annotate_bb() {
    [ "${#RECORDS[@]}" -gt 0 ] || return 0
    local rec touched kb branch status path main env i n=0 envs=() out=()
    for rec in "${RECORDS[@]}"; do
        IFS=$'\t' read -r touched kb branch status path main <<<"$rec"
        env="$(bb_env_dir_of "$path")" || env=""
        envs+=("$env")
        [ -n "$env" ] && n=$(( n + 1 ))
    done
    [ "$n" -gt 0 ] || return 0
    local ok=1
    if ! bb_load_threads; then
        ok=0
        printf '%s: warning: could not ask bb which threads are live (%s); treating all %d bb-managed worktree(s) as bb-live.\n' \
            "$EXTENSION_NAME" "$BB_FAIL" "$n" >&2
    fi
    for i in "${!RECORDS[@]}"; do
        rec="${RECORDS[$i]}"; env="${envs[$i]}"
        IFS=$'\t' read -r touched kb branch status path main <<<"$rec"
        if [ -n "$env" ] && { [ "$ok" = 0 ] || bb_is_live "$env" "$path"; }; then
            case "$status" in
                clean) status="bb-live" ;;
                *)     status="bb-live $status" ;;
            esac
        fi
        out+=("$touched"$'\t'"$kb"$'\t'"$branch"$'\t'"$status"$'\t'"$path"$'\t'"$main")
    done
    RECORDS=("${out[@]}")
}

# ---------------------------------------------------------------------------
# Scan roots
# ---------------------------------------------------------------------------
# Directories that trigger macOS TCC permission dialogs or are pure noise.
# Always pruned, even under --all.
TCC_DENY=(
    "$HOME/Library" "$HOME/Desktop" "$HOME/Documents" "$HOME/Downloads"
    "$HOME/Pictures" "$HOME/Movies" "$HOME/Music" "$HOME/Public"
    "$HOME/.Trash" "$HOME/Applications"
    "/Volumes" "/System" "/private" "/Network" "/cores" "/Library"
)

# Dependency lock files: regenerated from a manifest, so a change to one alone
# carries no authored content worth preserving. By default they are treated like
# .gitignored files -- a worktree whose only diff is lock-file churn is NOT marked
# dirty, and lock mtimes don't count toward its age. (`npm install` rewriting
# package-lock.json shouldn't pin a merged worktree as un-reapable.) Opt out with
# --no-ignore-locks. Two pathspecs per name match the file at the repo root and at
# any nesting depth.
REGENERABLE_LOCKS=(
    package-lock.json npm-shrinkwrap.json yarn.lock pnpm-lock.yaml
    bun.lockb bun.lock composer.lock Gemfile.lock Cargo.lock
    poetry.lock Pipfile.lock go.sum flake.lock gradle.lockfile
    packages.lock.json
)
LOCK_EXCLUDE=()
for __lock in "${REGENERABLE_LOCKS[@]}"; do
    LOCK_EXCLUDE+=( ":(exclude)$__lock" ":(exclude)*/$__lock" )
done
unset __lock

# Agent session markers: ephemeral bookkeeping a coding agent drops into the
# worktree it just created (e.g. a session-id pointer), never authored work.
# Such a file lands in *every* worktree the agent makes, so left uncounted it
# brands each finished agent worktree `dirty` and keeps `gh reaper --merged
# --reap` from ever sweeping it. Excluded unconditionally (no --no-ignore-locks
# escape hatch): there is no reading under which a session pointer is worth
# preserving. Agents that nest a native worktree under the repo and drop a
# marker:
#   qwen        <repo>/.qwen/worktrees/<slug>/.qwen-session
# (gemini and Claude Code nest at <repo>/.gemini|.claude/worktrees/<slug>/ but
#  leave the tree clean, so they need no marker entry here.)
AGENT_ARTIFACTS=(
    .qwen-session
)
ARTIFACT_EXCLUDE=()
for __art in "${AGENT_ARTIFACTS[@]}"; do
    ARTIFACT_EXCLUDE+=( ":(exclude)$__art" ":(exclude)*/$__art" )
done
unset __art

resolve_roots() {
    local candidates=()
    local r
    # Explicit paths win and skip the curated/TCC logic.
    if [ ${#extra_roots[@]} -gt 0 ]; then
        for r in "${extra_roots[@]}"; do candidates+=("$r"); done
    elif [ "$opt_all" = 1 ]; then
        candidates+=("$HOME")
    else
        # Curated, fast, TCC-safe defaults -- only the ones that exist.
        local maybe=(
            "$PWD"
            "$HOME/Developer" "$HOME/Projects" "$HOME/projects"
            "$HOME/Code" "$HOME/code" "$HOME/src" "$HOME/Source"
            "$HOME/dev" "$HOME/Dev" "$HOME/git" "$HOME/repos" "$HOME/Repositories"
            "$HOME/work" "$HOME/workspace" "$HOME/Workspace"
            "$HOME/conductor" "$HOME/.conductor"
            "$HOME/intent/workspaces"
            "$HOME/.codex/worktrees"
            "$HOME/worktrees" "$HOME/.worktrees"
            "$HOME/go/src"
        )
        # bb (getbb.app) parks every managed worktree environment under its data
        # directory, one env dir per environment -- outside any code root, so
        # nothing above would find them. Current bb uses
        # <data-dir>/plugins/environment-git-worktree/host-data/worktrees/<env>/<repo>,
        # older bb <data-dir>/worktrees/<env>/<repo>. The data dir is $HOME/.bb
        # by default, $HOME/.bb-dev for a dev build, and $BB_DATA_DIR when set;
        # list them all and let the existence check and dedupe sort it out.
        local dd
        while IFS= read -r dd; do
            maybe+=( "$dd/$BB_WT_SUBDIR" "$dd/worktrees" )
        done < <(bb_data_dirs)
        for r in "${maybe[@]}"; do [ -d "$r" ] && candidates+=("$r"); done
    fi

    # Normalize, dedupe, drop nonexistent.
    local seen=" "
    for r in "${candidates[@]}"; do
        [ -d "$r" ] || continue
        r="$(cd "$r" 2>/dev/null && pwd)" || continue
        case "$seen" in *" $r "*) continue ;; esac
        seen="$seen$r "
        printf '%s\n' "$r"
    done
}

# Emit '.git' worktree-marker files under a root, pruning heavy / protected dirs.
find_git_markers() {
    local root="$1"
    local prune=()
    local d
    for d in "${TCC_DENY[@]}"; do prune+=( -path "$d" -o ); done
    find "$root" \
        \( "${prune[@]}" \
           -type d \( -name node_modules -o -name .git -o -name .Trash \
                      -o -name Library -o -name .cache -o -name Caches \
                      -o -name .npm -o -name .pnpm-store -o -name .yarn \
                      -o -name .venv -o -name venv -o -name .tox \
                      -o -name .gradle -o -name .terraform -o -name .next \
                      -o -name DerivedData -o -name Pods -o -name '*.noindex' \
                      -o -name .workspace \) \
        \) -prune -o \
        -type f -name .git -print 2>/dev/null
}

# ---------------------------------------------------------------------------
# Inspect one worktree marker; append a record to RECORDS on success.
# Record fields (tab-separated): touched  kb  branch  status  path  main
# ---------------------------------------------------------------------------
inspect_marker() {
    local gitfile="$1" wt line gitdir
    wt="$(dirname "$gitfile")"

    IFS= read -r line < "$gitfile" 2>/dev/null || return 0
    case "$line" in gitdir:*) gitdir="${line#gitdir: }" ;; *) return 0 ;; esac
    # Only worktrees -- not submodules ('.../modules/...').
    case "$gitdir" in */worktrees/*) ;; *) return 0 ;; esac
    # Resolve a relative gitdir against the worktree.
    case "$gitdir" in /*) ;; *) gitdir="$wt/$gitdir" ;; esac

    # "Last touched" = the newest *non-gitignored* change (tracked/unignored file
    # mtime, or the last commit date). Build output, node_modules, caches and the
    # like are excluded, so a routine install/build/checkout no longer resets a
    # worktree's apparent age. Orphans (no usable git) fall back to the working-
    # dir / reflog mtime, since git can't enumerate the tree there.
    local kb touched dir_m logs_m branch status main
    local dirty=0 unpushed=0 merged=0 prmerged=0 locked=0 busy=0

    # `git worktree lock` writes its reason to <gitdir>/locked. Agent harnesses
    # lock the tree for the duration of a session and stamp the reason with their
    # pid; if that session dies the lock outlives it and `git worktree remove`
    # refuses the tree forever (only 'remove -f -f' overrides). Distinguish the
    # two cases: a lock whose owner is still running means real work is under
    # way (busy), a lock whose owner is gone is just debris to lift on reap.
    if [ -f "$gitdir/locked" ]; then
        locked=1
        local lock_reason="" lock_pid=""
        IFS= read -r lock_reason < "$gitdir/locked" 2>/dev/null || lock_reason=""
        # Anchor on "(pid N" / " pid N" so a reason like "rapid 5 retries"
        # can't be mined for a bogus pid.
        case "$lock_reason" in
            pid\ [0-9]*|*[\ \(]pid\ [0-9]*)
                lock_pid="${lock_reason#*pid }"
                lock_pid="${lock_pid%%[![:digit:]]*}"
                ;;
        esac
        [ -n "$lock_pid" ] && pid_alive "$lock_pid" && busy=1
    fi
    # No pipe into an early-exit filter here: on a big tree `du` is still
    # writing when the reader quits, and SIGPIPE + pipefail would kill us.
    kb="$(du -sk "$wt" 2>/dev/null)" || kb=""
    kb="${kb%%[[:space:]]*}"; : "${kb:=0}"
    dir_m="$(file_mtime "$wt")"
    logs_m="$(file_mtime "$gitdir/logs/HEAD")"

    if git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local commit_ct newest_m ahead up def
        commit_ct="$(git -C "$wt" log -1 --format=%ct 2>/dev/null || echo 0)"
        case "$commit_ct" in ''|*[!0-9]*) commit_ct=0 ;; esac
        newest_m="$(newest_unignored_mtime "$wt")"
        touched="$commit_ct"
        [ "$newest_m" -gt "$touched" ] && touched="$newest_m"
        # Degenerate worktree (no commits, no files): fall back to dir mtime.
        [ "${touched:-0}" -le 0 ] && touched="$dir_m"

        branch="$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
        [ -z "$branch" ] && branch="detached@$(git -C "$wt" rev-parse --short HEAD 2>/dev/null || echo '?')"

        # Dirty = uncommitted/untracked changes. Agent session markers never
        # count; regenerable lock-file churn doesn't either, unless
        # --no-ignore-locks (a lone package-lock.json edit isn't authored work).
        local dirty_excl=( "${ARTIFACT_EXCLUDE[@]}" )
        [ "${REAPER_IGNORE_LOCKS:-1}" = 1 ] && dirty_excl+=( "${LOCK_EXCLUDE[@]}" )
        [ -n "$(git -C "$wt" status --porcelain -- . "${dirty_excl[@]}" 2>/dev/null)" ] && dirty=1

        # Unpushed = commits that live nowhere on a remote.
        if up="$(git -C "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
            ahead="$(git -C "$wt" rev-list --count "${up}..HEAD" 2>/dev/null || echo 0)"
            [ "${ahead:-0}" -gt 0 ] && unpushed=1
        elif [ -z "$(git -C "$wt" branch -r --contains HEAD 2>/dev/null)" ]; then
            unpushed=1
        fi

        # Merged = HEAD is already contained in the repo's default branch. A
        # strong, age-independent "this work is done" signal, fully offline.
        def="$(git -C "$wt" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null)"
        if [ -z "$def" ]; then
            local c
            for c in origin/main origin/master main master; do
                git -C "$wt" rev-parse -q --verify "$c" >/dev/null 2>&1 && { def="$c"; break; }
            done
        fi
        if [ -n "$def" ] && git -C "$wt" merge-base --is-ancestor HEAD "$def" 2>/dev/null; then
            merged=1
        fi

        # Optional, network: a squash/rebase-merged branch is not an ancestor of
        # the default branch, yet its PR is merged. Only consult gh for branches
        # we could not confirm offline, and only when asked (--check-prs).
        if [ "$merged" = 0 ] && [ "${REAPER_CHECK_PRS:-0}" = 1 ] \
           && command -v gh >/dev/null 2>&1; then
            case "$branch" in
                detached@*|'') ;;  # no branch -> no PR to look up
                *)
                    local pr_n
                    pr_n="$( cd "$wt" 2>/dev/null \
                        && gh pr list --head "$branch" --state merged \
                             --limit 1 --json number -q 'length' 2>/dev/null )"
                    case "$pr_n" in ''|*[!0-9]*) pr_n=0 ;; esac
                    [ "$pr_n" -gt 0 ] && prmerged=1
                    ;;
            esac
        fi

        # First porcelain line is "worktree <main-path>"; parse without a pipe.
        main="$(git -C "$wt" worktree list --porcelain 2>/dev/null)" || main=""
        main="${main%%$'\n'*}"; main="${main#worktree }"
        [ -z "$main" ] && main="$wt"
    else
        # Git can't operate -> the main repo is gone.
        touched="$dir_m"
        [ "$logs_m" -gt "$touched" ] && touched="$logs_m"
        status="orphan"
        branch="?"
        if [ -r "$gitdir/HEAD" ]; then
            IFS= read -r line < "$gitdir/HEAD" 2>/dev/null || line=""
            branch="${line#ref: refs/heads/}"
        fi
        main=""
    fi

    # Assemble the status label. "merged"/"pr-merged" supersede "unpushed" --
    # those commits are accounted for in the default branch (or a merged PR).
    if [ "${status:-}" != "orphan" ]; then
        if [ "$merged" = 1 ] || [ "$prmerged" = 1 ]; then unpushed=0; fi
        status=""
        [ "$busy" = 1 ] && status="busy"
        [ "$dirty" = 1 ] && status="${status:+$status }dirty"
        [ "$unpushed" = 1 ] && status="${status:+$status }unpushed"
        [ "$locked" = 1 ] && status="${status:+$status }locked"
        if [ "$prmerged" = 1 ]; then status="${status:+$status }pr-merged"
        elif [ "$merged" = 1 ]; then status="${status:+$status }merged"; fi
        [ -z "$status" ] && status="clean"
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$touched" "$kb" "$branch" "$status" "$wt" "$main"
}

# ---------------------------------------------------------------------------
# Reaping
# ---------------------------------------------------------------------------
# `locked` is deliberately absent: a lock whose owner died is exactly the debris
# this tool exists to clear, and reap_one lifts it. A lock still held reads as
# `busy` instead, which does gate on --force.
is_risky() { case "$1" in *busy*|*dirty*|*unpushed*|*orphan*) return 0 ;; *) return 1 ;; esac; }

# `bb-live` is not risky, it is off limits: its bb thread is still open and will
# run its next turn in this tree. No flag reaps it -- archive the thread instead.
is_protected() { case "$1" in *bb-live*) return 0 ;; *) return 1 ;; esac; }

# Removing a worktree can leave its parent directory behind, empty. Harnesses
# that give every session its own container dir -- bb's
# <data-dir>/worktrees/<env-id>/<repo>, Conductor's <repo>/.conductor/<name> --
# would otherwise accumulate one empty husk per tree reaped. Drop the parent
# only when it is empty *and* is not itself a scan root, so a directory you
# created on purpose (~/worktrees, ~/Developer) never vanishes under you.
prune_empty_parent() {
    local parent; parent="$(dirname "$1")"
    case "$parent" in /|"$HOME") return 0 ;; esac
    case "$SCAN_ROOTS" in *" $parent "*) return 0 ;; esac
    rmdir "$parent" 2>/dev/null || true
}

reap_one() {
    local wt="$1" main="$2" status="$3"
    # Belt and braces: the reap loop already skips these.
    if is_protected "$status"; then printf 'bb-live: refusing to reap'; return 1; fi
    if [ "$status" = "orphan" ] || [ -z "$main" ]; then
        rm -rf "$wt" || return 1
        prune_empty_parent "$wt"
        return 0
    fi
    # Lift a stale lock first. `git worktree remove --force` does NOT override a
    # lock -- git demands 'remove -f -f' -- and we have already judged this tree
    # reapable, so unlock rather than escalating to double force.
    case "$status" in
        *locked*) git -C "$main" worktree unlock "$wt" >/dev/null 2>&1 || true ;;
    esac
    local args=(worktree remove)
    # Risky statuses force by classification. A worktree we already judged
    # reapable (clean/merged) can still carry ignored lock-file churn or an agent
    # session file that plain `git worktree remove` refuses ("contains modified
    # or untracked files") -- force past that too, the decision to reap is made.
    if is_risky "$status" || [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then
        args+=(--force)
    fi
    args+=("$wt")
    local out rc=0
    out="$(git -C "$main" "${args[@]}" 2>&1)" || rc=$?
    [ "$rc" -eq 0 ] && prune_empty_parent "$wt"
    printf '%s' "$out"
    return "$rc"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    parse_args "$@"
    setup_colors

    if stat --version >/dev/null 2>&1; then STAT_GNU=1; else STAT_GNU=0; fi

    local NOW; NOW="$(date +%s)"
    local min_age_secs=$(( opt_min_age_days * 86400 ))
    local min_kb=$(( opt_min_size_mb * 1024 ))

    # ---- discover ----
    local roots=(); local root
    while IFS= read -r root; do roots+=("$root"); done < <(resolve_roots)
    for root in "${roots[@]:-}"; do [ -n "$root" ] && SCAN_ROOTS="$SCAN_ROOTS$root "; done
    if [ ${#roots[@]} -eq 0 ]; then
        echo "No scannable directories found. Pass a PATH or use --all." >&2
        exit 1
    fi

    local jobs="${opt_jobs:-$(detect_jobs)}"

    # ---- collect unique worktree markers across all roots ----
    local markers=() marker seen_markers=" "
    for root in "${roots[@]}"; do
        while IFS= read -r marker; do
            [ -n "$marker" ] || continue
            case "$seen_markers" in *" $marker "*) continue ;; esac
            seen_markers="$seen_markers$marker "
            markers+=("$marker")
        done < <(find_git_markers "$root")
    done

    if [ "$opt_json" = 0 ]; then
        printf '%s%s: inspecting %d worktree(s) across %d root(s), %d job(s)...%s\n' \
            "$C_DIM" "$EXTENSION_NAME" "${#markers[@]}" "${#roots[@]}" "$jobs" "$C_RESET" >&2
    fi

    # ---- inspect markers in parallel ----
    # Each worker (a re-invocation of this script) appends finished records to
    # its own per-PID temp file, so output never interleaves and we don't rely
    # on pipe write-atomicity. The slow part (du + git per worktree) now runs
    # `jobs`-wide instead of serially.
    RECORDS=()
    if [ ${#markers[@]} -gt 0 ]; then
        local outdir rec_line
        outdir="$(mktemp -d)"
        printf '%s\0' "${markers[@]}" \
            | REAPER_OUT_DIR="$outdir" REAPER_CHECK_PRS="$opt_check_prs" \
              REAPER_IGNORE_LOCKS="$opt_ignore_locks" \
              xargs -0 -P "$jobs" -n 16 "$SELF_PATH" --__inspect 2>/dev/null || true
        while IFS= read -r rec_line; do
            [ -n "$rec_line" ] && RECORDS+=("$rec_line")
        done < <(cat "$outdir"/*.tsv 2>/dev/null)
        rm -rf "$outdir"
    fi

    # Flag the worktrees a live process is sitting in. Done here, once, rather
    # than inside the parallel workers: a single process-table scan answers for
    # every worktree at once.
    annotate_busy

    # Ask bb (once) whether the thread owning each bb-managed worktree is still
    # open; those read bb-live and are never reaped.
    annotate_bb

    # ---- filter + sort (oldest first) ----
    local filtered=()
    local rec touched kb branch status path main age
    for rec in "${RECORDS[@]:-}"; do
        [ -n "$rec" ] || continue
        IFS=$'\t' read -r touched kb branch status path main <<<"$rec"
        age=$(( NOW - touched ))
        [ "$age" -lt "$min_age_secs" ] && continue
        [ "$kb" -lt "$min_kb" ] && continue
        if [ "$opt_merged_only" = 1 ]; then
            case "$status" in *merged*) ;; *) continue ;; esac
        fi
        filtered+=("$rec")
    done

    if [ ${#filtered[@]} -eq 0 ]; then
        if [ "$opt_json" = 1 ]; then echo "[]"; else
            printf '%sNothing to reap.%s The fields are clean.\n' "$C_GREEN" "$C_RESET"
        fi
        exit 0
    fi

    # Sort ascending by touched epoch (first field).
    local sorted=()
    while IFS= read -r rec; do sorted+=("$rec"); done < <(printf '%s\n' "${filtered[@]}" | sort -t$'\t' -k1,1n)

    # ---- JSON output ----
    if [ "$opt_json" = 1 ]; then
        printf '%s\n' "${sorted[@]}" | jq -R -s --argjson now "$NOW" '
            split("\n") | map(select(length>0)) | map(split("\t")) |
            map({
              path: .[4], branch: .[2], status: .[3],
              merged: (.[3]|test("merged")),
              busy: (.[3]|test("busy")),
              bbLive: (.[3]|test("bb-live")),
              locked: (.[3]|test("locked")),
              sizeKb: (.[1]|tonumber),
              touched: (.[0]|tonumber),
              ageDays: (($now - (.[0]|tonumber)) / 86400 | floor),
              mainWorktree: .[5]
            })'
        exit 0
    fi

    # ---- table ----
    local total_kb=0
    printf '\n%s%-6s %8s  %-14s %-22s %s%s\n' "$C_BOLD" "AGE" "SIZE" "STATUS" "BRANCH" "PATH" "$C_RESET"
    for rec in "${sorted[@]}"; do
        IFS=$'\t' read -r touched kb branch status path main <<<"$rec"
        age=$(( NOW - touched ))
        total_kb=$(( total_kb + kb ))
        local color="$C_DIM"
        # bb-live/busy first: such a tree can also be merged, and must not read green.
        case "$status" in
            *bb-live*|*busy*)    color="$C_CYAN" ;;
            *orphan*)            color="$C_RED" ;;
            *dirty*|*unpushed*)  color="$C_YELLOW" ;;
            *merged*|clean)      color="$C_GREEN" ;;
        esac
        local br="$branch"; [ ${#br} -gt 22 ] && br="${br:0:21}…"
        printf '%s%-6s %8s  %-14s %-22s %s%s\n' \
            "$color" "$(human_age "$age")" "$(human_size_kb "$kb")" \
            "$status" "$br" "$(tilde "$path")" "$C_RESET"
    done
    printf '%s%d worktree(s), %s total%s\n\n' \
        "$C_DIM" "${#sorted[@]}" "$(human_size_kb "$total_kb")" "$C_RESET"

    # Read-only unless explicitly asked to reap.
    if [ "$opt_reap" != 1 ]; then
        if [ "$opt_yes" = 1 ] || [ "$opt_force" = 1 ] || [ "$opt_prune" = 1 ]; then
            printf '%snote: --yes/--force/--prune do nothing without --reap; nothing was deleted.%s\n' \
                "$C_DIM" "$C_RESET" >&2
        fi
        printf '%sRead-only listing -- nothing deleted. Add %s--reap%s%s to delete (interactive), or %s--reap --yes%s%s to skip prompts.%s\n' \
            "$C_DIM" "$C_BOLD$C_CYAN" "$C_RESET" "$C_DIM" "$C_BOLD$C_CYAN" "$C_RESET" "$C_DIM" "$C_RESET"
        exit 0
    fi

    # ---- reap ----
    local reap_all="$opt_yes" reaped=0 freed_kb=0 ans out
    local touched_mains=()
    for rec in "${sorted[@]}"; do
        IFS=$'\t' read -r touched kb branch status path main <<<"$rec"

        # Not even --force: the tree belongs to an open bb thread.
        if is_protected "$status"; then
            printf '%s skip%s %s %s(%s -- its bb thread is still open; archive it in bb first)%s\n' \
                "$C_CYAN" "$C_RESET" "$(tilde "$path")" "$C_DIM" "$status" "$C_RESET"
            continue
        fi

        if is_risky "$status" && [ "$opt_force" != 1 ]; then
            printf '%s skip%s %s %s(%s -- needs --force)%s\n' \
                "$C_YELLOW" "$C_RESET" "$(tilde "$path")" "$C_DIM" "$status" "$C_RESET"
            continue
        fi

        if [ "$reap_all" != 1 ]; then
            printf 'Reap %s%s%s [%s, %s, %s]? [y/N/a/q] ' \
                "$C_CYAN" "$(tilde "$path")" "$C_RESET" \
                "$(human_age $(( NOW - touched )))" "$(human_size_kb "$kb")" "$status"
            read -r ans </dev/tty || ans="q"
            case "$ans" in
                y|Y) ;;
                a|A) reap_all=1 ;;
                q|Q) echo "Stopped."; break ;;
                *)   continue ;;
            esac
        fi

        if out="$(reap_one "$path" "$main" "$status")"; then
            printf '%s reaped%s %s\n' "$C_GREEN" "$C_RESET" "$(tilde "$path")"
            reaped=$(( reaped + 1 ))
            freed_kb=$(( freed_kb + kb ))
            [ -n "$main" ] && touched_mains+=("$main")
        else
            printf '%s failed%s %s\n  %s%s%s\n' \
                "$C_RED" "$C_RESET" "$(tilde "$path")" "$C_DIM" "$out" "$C_RESET"
        fi
    done

    if [ "$opt_prune" = 1 ] && [ ${#touched_mains[@]} -gt 0 ]; then
        local m seen=" "
        for m in "${touched_mains[@]}"; do
            case "$seen" in *" $m "*) continue ;; esac
            seen="$seen$m "
            git -C "$m" worktree prune 2>/dev/null || true
        done
    fi

    printf '\n%sReaped %d worktree(s), reclaimed %s.%s\n' \
        "$C_BOLD" "$reaped" "$(human_size_kb "$freed_kb")" "$C_RESET"
}

# Internal parallel-inspection worker (not a public interface). main() re-invokes
# this script via xargs as `gh-reaper --__inspect <marker>...`; each call writes
# one TSV record per valid worktree to $REAPER_OUT_DIR/$$.tsv (or stdout).
if [ "${1:-}" = "--__inspect" ]; then
    if stat --version >/dev/null 2>&1; then STAT_GNU=1; else STAT_GNU=0; fi
    shift
    for __m in "$@"; do
        __rec="$(inspect_marker "$__m" 2>/dev/null)" || __rec=""
        [ -n "$__rec" ] || continue
        if [ -n "${REAPER_OUT_DIR:-}" ]; then
            printf '%s\n' "$__rec" >> "$REAPER_OUT_DIR/$$.tsv"
        else
            printf '%s\n' "$__rec"
        fi
    done
    exit 0
fi

check_dependencies
main "$@"
